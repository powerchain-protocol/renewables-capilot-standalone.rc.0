# App
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_POWERCHAIN_NETWORK=devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# OpenAI / GRIDLLM (server only)
OPENAI_API_KEY=
OPENAI_MODEL_QUALITY=gpt-5.6-sol
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_FAST=gpt-5.6-luna


# Multi-provider AI (server only)
AI_PROVIDER_ORDER=openai,anthropic,google,deepseek,lora
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_QUALITY=claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
GOOGLE_API_KEY=
GOOGLE_MODEL_QUALITY=gemini-3.7-flash
GOOGLE_MODEL=gemini-3.6-flash
GOOGLE_MODEL_FAST=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_QUALITY=deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODEL_FAST=deepseek-chat

# Optional OpenAI-compatible LoRA / private model endpoint (server only)
LORA_BASE_URL=
LORA_API_KEY=
LORA_MODEL=gridllm-renewables-lora

# Helius (server only — never expose this key in NEXT_PUBLIC_*)
