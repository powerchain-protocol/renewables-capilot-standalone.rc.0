# PowerChain Renewables Copilot — local environment
# Copy to .env.local. Optional integrations should be LEFT BLANK rather than set to placeholder text.

# App
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_POWERCHAIN_NETWORK=devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Browser-safe Solana RPC endpoints.
# Public endpoints are suitable for development/fallback only; use a dedicated provider for production traffic.
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Server-side public RPC fallback. These may point to dedicated private RPC services in production.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Canonical Solana / PowerChain public identifiers
NEXT_PUBLIC_PWRC_MINT=PWRCRXXZxbg6FdQZfK3PMD7KP8xfxs9acvifJiG46wc
NEXT_PUBLIC_SPL_TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
NEXT_PUBLIC_TOKEN_2022_PROGRAM_ID=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
NEXT_PUBLIC_ASSOCIATED_TOKEN_PROGRAM_ID=ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL

# PowerChain program IDs — keep blank until each deployment is verified.
NEXT_PUBLIC_NATIVE_TOKEN_PROGRAM_ID=
NEXT_PUBLIC_ENERGY_TOKEN_PROGRAM_ID=
NEXT_PUBLIC_PROOF_OF_ENERGY_PROGRAM_ID=
NEXT_PUBLIC_CARBON_CREDIT_PROGRAM_ID=
NEXT_PUBLIC_TOKEN_FACTORY_PROGRAM_ID=
NEXT_PUBLIC_MARKETPLACE_PROGRAM_ID=
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
NEXT_PUBLIC_TREASURY_PROGRAM_ID=

# Helius — SERVER ONLY. Never expose HELIUS_API_KEY with NEXT_PUBLIC_.
HELIUS_API_KEY=
HELIUS_RPC_NETWORK=devnet
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com
HELIUS_MAINNET_RPC_URL=https://mainnet.helius-rpc.com
HELIUS_API_BASE_URL=https://api.helius.xyz

# OpenAI / GRIDLLM — server only
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
# Compatibility alias for teams that call the OpenAI Responses endpoint the “ChatGPT API”.
CHATGPT_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL_QUALITY=gpt-5.6-sol
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_FAST=gpt-5.6-luna

# Multi-provider AI — server only
AI_PROVIDER_ORDER=openai,anthropic,google,deepseek,lora
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_QUALITY=claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
GOOGLE_API_KEY=
GOOGLE_MODEL_QUALITY=gemini-3.7-flash
GOOGLE_MODEL=gemini-3.6-flash
GOOGLE_MODEL_FAST=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_QUALITY=deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODEL_FAST=deepseek-chat

# Optional OpenAI-compatible LoRA / private model endpoint — server only
LORA_BASE_URL=
LORA_API_KEY=
LORA_MODEL=gridllm-renewables-lora

# PostgreSQL / Prisma (e.g. Supabase Postgres connection string)
DATABASE_URL=

# Supabase — leave both blank when Supabase is not configured.
# Do not use values like "your-project-url": malformed optional values are ignored at runtime,
# but config validation will report them when explicitly supplied.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pyth / oracle data — server only
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=

# API / uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_MAX_BYTES=10485760
