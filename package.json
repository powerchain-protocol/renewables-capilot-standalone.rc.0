{
  "name": "@powerchain/renewables-copilot",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbopack",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck",
    "supabase:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "pnpm prisma:clean && prisma generate",
    "prisma:studio": "prisma studio",
    "db:test": "tsx scripts/test-database.ts",
    "config:validate": "node --env-file=.env.local scripts/validate-config.mjs",
    "telemetry:disable": "next telemetry disable",
    "pnpm:approve-builds": "pnpm approve-builds",
    "setup:local": "pnpm telemetry:disable && pnpm prisma:generate",
    "prisma:validate": "prisma validate",
    "db:seed": "tsx scripts/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "validate": "node scripts/validate-structure.mjs && pnpm typecheck",
    "open:app": "tsx scripts/open-app.ts",
    "prisma:clean": "node scripts/prepare-prisma-output.mjs",
    "deps:why:deprecated": "pnpm why uuid node-domexception || true",
    "peers:check": "pnpm peers check",
    "security:why": "pnpm why image-size image-size-next deepmerge-ts lodash uuid ws || true",
    "security:audit": "pnpm audit --prod --audit-level=moderate",
    "security:check": "pnpm security:why && pnpm security:audit",
    "config:doctor": "tsx scripts/config-doctor.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.40",
    "@ai-sdk/deepseek": "3.0.29",
    "@ai-sdk/google": "4.0.47",
    "@ai-sdk/openai": "4.0.42",
    "@ai-sdk/openai-compatible": "3.0.31",
    "@anthropic-ai/sdk": "0.117.1",
    "@google/genai": "2.17.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/web3.js": "1.98.4",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@web3icons/react": "4.1.21",
    "ai": "7.0.68",
    "axios": "1.19.0",
    "bs58": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "lodash": "4.18.1",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "open": "11.0.1",
    "openai": "7.5.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/lodash": "4.17.25",
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "prisma": "7.9.1",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
