{
  "name": "@powerchain/backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbopack -p 3002",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p 3002",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node scripts/ensure-prisma.mjs generate",
    "prisma:validate": "node scripts/ensure-prisma.mjs validate",
    "pretypecheck": "node scripts/ensure-prisma.mjs",
    "prebuild": "node scripts/ensure-prisma.mjs",
    "predev": "node scripts/ensure-prisma.mjs"
  },
  "dependencies": {
    "@powerchain/auth": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.2",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "prisma": "7.9.1",
    "typescript": "5.9.3",
    "dotenv": "17.4.2"
  }
}
